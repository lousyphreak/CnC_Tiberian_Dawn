+
+  if (dest_x < 0) {
+    src_x = -dest_x;
+    w += dest_x;
+    dest_x = 0;
+  }
+  if (dest_y < 0) {
+    src_y = -dest_y;
+    h += dest_y;
+    dest_y = 0;
+  }
+  if (dest_x + w > view->Get_Width()) {
+    w = view->Get_Width() - dest_x;
