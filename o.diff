-	mov	ah,al			; preserve real pixel
-	xlat				; get new al (transluecent pixel
-	xchg	ah,al			; get real pixel back into AL just in case
-	cmp	ah,255
-	je	short ??normal_pixel		; is it a translucent ?
-					; if we get passed here value in
-					; AH should be 0-15
