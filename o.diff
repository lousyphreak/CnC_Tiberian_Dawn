+BOOL SetEvent(HANDLE handle)
+{
+    if (!handle) return 0;
+    auto* event = static_cast<EventHandle*>(handle);
+    std::scoped_lock lock(event->mutex);
+    event->signaled = true;
+    event->condition.notify_all();
