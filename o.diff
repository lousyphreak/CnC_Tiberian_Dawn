+		char const* Filename;
+		uint16_t Date;
+		uint16_t Time;
+		unsigned Allocated : 1;
+};
+
+inline char const* RawFileClass::File_Name(void) const
+{
+	return Filename;
+}
+
+inline RawFileClass::RawFileClass(void)
+	: Rights(READ)
+	, BiasStart(0)
+	, BiasLength(-1)
+	, Handle(nullptr)
+	, Filename(NULL)
+	, Date(0)
+	, Time(0)
+	, Allocated(false)
+{
+}
