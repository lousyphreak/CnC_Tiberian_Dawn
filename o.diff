+bool WWFS_SyncEmscriptenAssetCache()
+{
+    if (!WWFS_InitializeEmscriptenAssetCache()) {
+        return false;
+    }
+
+    if (!wwfs_emscripten_sync_cache_js()) {
+        SDL_SetError("Failed to sync the Emscripten asset cache");
+        return false;
+    }
+
+    return true;
+}
