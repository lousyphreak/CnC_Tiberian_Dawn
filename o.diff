-							; Add the (trans_color * 256) of the translation equ.
-		mov	al , [ BYTE PTR ebx + eax ]	; get new pixel in al
-
-	store_pixel:
-		mov	[ edi ] , al
-		inc	edi
-
-	ENDM
-
-??ghost_reference:
-	dec	ecx
-	jge	??ghost_line
-
-	add	esi , [ scr_adjust_width ]
-	add	edi , [ dest_adjust_width ]
-	dec	edx
-	jnz	??ghost_loop
-
-	epilogue
-	ret
