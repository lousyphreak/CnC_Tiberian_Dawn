-;
-; Here are prototypes for the routines defined within this module:
-; VOID Install_Page_Fault_Handle (void) ;
-;
-; ----------------------------------------------------------------
-
-IDEAL				; the product runs in ideal mode
-P386				; use 386 real mode instructions
-MODEL USE32 FLAT
