+
+#include <stdlib.h>
+#include <stdarg.h>
+#include <time.h>
+
+
+
+
+/***************************************************************************
+ * EXIT -- Exit routine with message.                                      *
+ *                                                                         *
+ *                                                                         *
+ *                                                                         *
+ * INPUT:                                                                  *
+ *                                                                         *
+ * OUTPUT:                                                                 *
+ *                                                                         *
+ * WARNINGS:                                                               *
+ *                                                                         *
+ * HISTORY:                                                                *
+ *   08/03/1994 SKB : Created.                                             *
+ *=========================================================================*/
+void  Exit(int32_t errorval, const char *message, ...)
+{
+	va_list		argptr;
+	char		errstring[256];
+
+	Prog_End();
+
+	if (message && *message) {
+		va_start (argptr, message);
+		vsprintf ((char *)errstring, (const char *)message, argptr);
+		va_end (argptr);
+		printf("%s", errstring);
+	}
+
+	::exit(errorval);
+
+}
+
+void randomize	( void )
+{
+  srand ( time ( NULL ) ) ;
+}
