-global	BF_Predator_Ghost_Fading_Trans:near
-BF_Predator_Ghost_Fading_Trans:
-
-	prologue
-	mov	ebx , eax			; width
-
-	; NOTE: the below calculation assumes a group of instructions is
-	;	less than 256 bytes
