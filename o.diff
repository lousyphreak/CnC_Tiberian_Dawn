+extern KeyboardClass *Keyboard;
+
+
+#define	ARRAY_SIZE(x)		int(sizeof(x)/sizeof(x[0]))
+
+namespace {
+
+bool CapsLock_Affects_Key(uint16_t key)
+{
+	key &= 0xFF;
+	return (key >= KN_A && key <= KN_Z);
+}
+
+bool NumLock_Affects_Key(uint16_t key)
+{
+	key &= 0xFF;
+	return (key >= 0x60 && key <= 0x6F);
+}
+
+}
