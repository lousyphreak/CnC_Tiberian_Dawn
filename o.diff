-void TcpipManagerClass::Clear_Socket_Error(SOCKET socket)
-{
-	unsigned long error_code;
-	int length = 4;
-
-	getsockopt (socket, SOL_SOCKET, SO_ERROR, (char*)&error_code, &length);
-	error_code = 0;
-	setsockopt (socket, SOL_SOCKET, SO_ERROR, (char*)&error_code, length);
-}
