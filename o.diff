-		DB	00CH,000H,000H,000H,000H,000H,000H,000H
-		DB	000H,000H,000H,000H,000H,000H,000H,000H
-
-		DB	00DH,000H,000H,000H,000H,000H,000H,000H
-		DB	000H,000H,000H,000H,000H,000H,000H,000H
-
-		DB	00EH,000H,000H,000H,000H,000H,000H,000H
-		DB	000H,000H,000H,000H,000H,000H,000H,000H
