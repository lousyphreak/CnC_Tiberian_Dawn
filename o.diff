-	sub	edi,4
-	rep movsd
-
-	; Reduce the list count by one.
-??nocopy:
-	mov	edi,[index]
-	dec	[DWORD PTR edi]
-
-??fini2:
-	ret
-
-	ENDP	Remove_From_List
