-		mov	bh , [ BYTE PTR ebx + eax ]
-		cmp	bh , 0ffh
-		je	store_pixel
-
-		and	ebx , 0FF00h			; clear all of ebx except bh
-							; we have the index to the translation table
-							; ((trans_colour * 256) + dest colour)
-		mov	al , [ edi ]			; mov pixel at destination to al
