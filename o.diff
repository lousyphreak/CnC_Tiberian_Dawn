+			NOT_CONNECTING,
+			CONNECTING,
+			UNABLE_TO_CONNECT_TO_SERVER,
+			CONTACTING_SERVER,
+			SERVER_ADDRESS_LOOKUP_FAILED,
+			RESOLVING_HOST_ADDRESS,
