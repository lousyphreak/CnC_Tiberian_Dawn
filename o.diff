-	prologue
-; calc the code location to skip to 10 bytes per REPT below!!!!
-	mov	ecx , eax
-	and	ecx , 01fh
-	lea	ecx , [ ecx + ecx * 4 ]		; quick multiply by 5
-	neg	ecx
-	shr	eax , 5
-	lea	ecx , [ ??trans_reference + ecx * 2 ] ; next multiply by 2
-	mov	[ loop_cnt ] , eax
-	mov	[ jmp_loc ] , ecx
-
-??trans_loop:
-	mov	ecx , [ loop_cnt ]
-	jmp	[ jmp_loc ]
-
-; the following code should NOT be changed without changing the calculation
-; above!!!!!!
-
-??trans_line:
-
-	REPT	32
-	local	trans_pixel
-		mov	bl , [ esi ]
-		inc	esi
-		test	bl , bl
-		jz	trans_pixel
-
-		mov	[ edi ] , bl
-
-	trans_pixel:
-		inc	edi
-	ENDM
-
