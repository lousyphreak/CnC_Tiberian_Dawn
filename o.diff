diff --git a/WIN32LIB/INCLUDE/VQM32/MIXFILE.H b/WIN32LIB/INCLUDE/VQM32/MIXFILE.H
new file mode 100644
index 0000000..f4a1e91
--- /dev/null
+++ b/WIN32LIB/INCLUDE/VQM32/MIXFILE.H
@@ -0,0 +1,105 @@
+/*
