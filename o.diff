+ *                                                                         *
+ *                  Last Update : May 2, 1995   [JRJ]                      *
+ *                                                                         *
+ *-------------------------------------------------------------------------*
+ * Functions:                                                              *
+ * int Save_PCX_File (char* name, GraphicViewPortClass& pic, char* palette)*
+ *= = = = = = = = = = = = = = = = = = = = = = = = = = = = = = = = = = = = =*/
+
+#include  <WWSTD.H>
+#include "FILEPCX.H"
+#include <WWMEM.H>
+static void Write_Pcx_ScanLine ( int32_t file_handle , int32_t scansize , char * ptr );
