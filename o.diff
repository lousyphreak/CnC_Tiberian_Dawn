-	mov	ecx,[edi]
-	jcxz	short ??fini2
-
-	; Fetch pointer to list.
-	cmp	[list],0
-	je	short ??fini2
-	mov	edi,[list]
-
-	; Loop through all elements searching for a match.
-	mov	eax,[element]
-	repne scasd
-	jne	short ??fini2		; No match found.
-
-	; Copy all remaining elements down.  If this is the
